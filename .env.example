# MarketGPT Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# LLM Provider Configuration
# ============================================
# Select your LLM provider: local, openai, claude, or ollama
LLM_PROVIDER=local

# ============================================
# OpenAI Configuration
# ============================================
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4

# ============================================
# Claude (Anthropic) Configuration
# ============================================
# CLAUDE_API_KEY=sk-ant-your-claude-api-key-here
# CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================
# Ollama Configuration
# ============================================
# OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
# OLLAMA_MODEL=llama3.2

# ============================================
# Local LLM Configuration (LM Studio, etc.)
# ============================================
# LOCAL_LLM_ENDPOINT=http://localhost:1234/v1/chat/completions
# LOCAL_LLM_MODEL=

# ============================================
# Application Configuration
# ============================================
# Flask server port (default: 5070)
PORT=5070

# Flask environment (development, production)
# FLASK_ENV=development

# News fetch interval in minutes (default: 30)
# Adjust based on your needs:
# - 15-20 min: More frequent updates (higher system load)
# - 30 min: Good balance (default)
# - 60+ min: Less frequent updates (lower system load)
NEWS_FETCH_INTERVAL_MINUTES=30
